{
  "name": "frondose",
  "version": "0.1.16",
  "private": true,
  "homepage": "https://github.com/Evan1108-Coder/frondose",
  "type": "module",
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-pty.mjs",
    "dev": "vite",
    "start": "node scripts/start-local.mjs",
    "local": "node scripts/start-local.mjs",
    "desktop": "node desktop/launch.mjs",
    "desktop:pack": "node scripts/desktop-package.mjs --dir",
    "desktop:dist": "node scripts/desktop-package.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "test:refresh": "node --test tests/workspace-tabs.test.mjs tests/workspace-settings.test.mjs tests/workspace-surface.test.mjs tests/directory-workspace.test.mjs tests/directory-files-ui.test.mjs tests/native-agent-authorization.test.mjs tests/native-agent-session.test.mjs tests/terminal-splits.test.mjs tests/terminal-launch-plan.test.mjs tests/terminal-native-workbench.test.mjs tests/desktop-browser.test.mjs tests/desktop-package.test.mjs tests/workspace-onboarding.test.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:api": "node --test tests/local-api.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "runner": "node scripts/frondose-runner.mjs",
    "test:runner": "node --test tests/runner-provider-catalog.test.mjs tests/runner-process.test.mjs tests/runner-events.test.mjs tests/runner-acp-runtime.test.mjs tests/runner-connections.test.mjs tests/runner-helper.test.mjs tests/runner-connections-api.test.mjs tests/runner-public.test.mjs tests/agent-runner-settings.test.mjs tests/runner-runtime.test.mjs tests/runner-runtime-events.test.mjs tests/runner-runtime-cleanup.test.mjs tests/runner-jobs.test.mjs tests/runner-execution-helper.test.mjs tests/runner-execution-api.test.mjs tests/runner-execution-sharing-api.test.mjs"
  },
